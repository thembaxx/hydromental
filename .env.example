# Optional public origin for canonical URLs and the sitemap.
# Set this to your actual HTTPS origin in the production environment.
# An empty value uses Vercel's production project domain or localhost locally.
NEXT_PUBLIC_SITE_URL=

# Optional custom product/Web Vital events require an existing Pro or Enterprise plan.
# Production CI detects eligibility; this does not upgrade the hosting plan.
# Page analytics and free Speed Insights still require the visitor's explicit consent.
NEXT_PUBLIC_PRODUCT_EVENTS_ENABLED=false
