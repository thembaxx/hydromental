{
  "name": "elementals",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "test:e2e": "playwright test",
    "security:audit": "pnpm audit --audit-level=high",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "science:check": "node scripts/refresh-science.mjs --check",
    "release": "semantic-release",
    "science:refresh": "node scripts/refresh-science.mjs",
    "science:report": "node scripts/science-report.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "repository:configure": "node scripts/configure-repository.mjs",
    "test:devices": "playwright test --config playwright.devices.config.ts",
    "performance:check": "node scripts/check-performance.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@phosphor-icons/react": "2.1.10",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.2.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "parse5": "8.0.1",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vercel": "64.0.2"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "12.9.1"
  },
  "packageManager": "pnpm@12.9.1"
}
